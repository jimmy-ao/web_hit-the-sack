# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version 
# control as they are data points which are potentially sensitive and subject 
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# .terraform.lock.hcl is NOT transient — it pins provider versions and their
# checksums, and CI runs `terraform init -lockfile=readonly`, which fails
# without it. It must be committed. (AUDIT.md M4)

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore backend files as they usually contain sensitive data
backend.hcl
**backend.hcl

# Generated by the CI workflows from repository secrets
backend.ci.hcl

# Ignore Nodes modules
node_modules
_stale-root/

# Astro build output
dist/
.astro/

# Archives / env
*.zip
.env
.env.*

# Personal md file
AUDIT-hit-the-sack.md
ARTICLE-hit-the-sack.md

# macOS
.DS_Store

# Actions
.github